            "date": 1762257567105,
            "name": "Commit-0",
            "content": "{% extends \"guest.html\" %}\r\n{% load static %}\r\n\r\n{% block title %}Cacao Marketplace{% endblock %}\r\n\r\n{% block extra_css %}\r\n<style>\r\n    .product-card {\r\n        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;\r\n    }\r\n    .product-card:hover {\r\n        transform: translateY(-4px);\r\n        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);\r\n    }\r\n    .filter-badge {\r\n        transition: all 0.2s ease-in-out;\r\n    }\r\n    .filter-badge:hover {\r\n        transform: scale(1.05);\r\n    }\r\n    .login-overlay {\r\n        background: rgba(0, 0, 0, 0.8);\r\n        backdrop-filter: blur(4px);\r\n    }\r\n</style>\r\n{% endblock %}\r\n\r\n{% block content %}\r\n<div class=\"min-h-screen bg-gradient-to-br from-amber-50 to-orange-50\">\r\n    <!-- Header Section -->\r\n    <div class=\"bg-white text-gray-800 shadow-sm border-b\">\r\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6\">\r\n            <div class=\"flex flex-col lg:flex-row lg:items-center lg:justify-between\">\r\n                <div class=\"flex items-center\">\r\n                    <div class=\"flex-shrink-0 flex items-center\">\r\n                        <img alt=\"CacaoGuard logo\" class=\"w-10 h-10 rounded-full\" src=\"{% static 'images/NOBGHERO.png' %}\"/>\r\n                        <span class=\"ml-2 font-semibold text-xl\"></span>\r\n                    </div>\r\n                    <div class=\"ml-4\">\r\n                        <h1 class=\"text-3xl font-bold\">Welcome to CacaoGuard Marketplace</h1>\r\n                        <p class=\"text-blue-100\">Discover a wide range of products and services for your needs.</p>\r\n                    </div>\r\n                </div>\r\n                \r\n                \r\n                <!-- Login/Register Buttons -->\r\n                <div class=\"mt-4 lg:mt-0 flex space-x-3\">\r\n                   <a href=\"{% url 'guest_dashboard' %}\" class=\"px-4 py-2 bg-blue-300 text-white rounded-lg hover:bg-blue-400 transition-colors\">\r\n                       <svg class=\"w-5 h-5 inline mr-2 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\r\n                           <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 9.75L12 3l9 6.75V21a1.5 1.5 0 01-1.5 1.5h-15A1.5 1.5 0 013 21V9.75z\" />\r\n                           <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 22V12h6v10\" />\r\n                       </svg>\r\n                       Dashboard\r\n                   </a>\r\n\r\n                    <a href=\"{% url 'login' %}\" class=\"px-4 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 transition-colors\">\r\n                        <svg class=\"w-5 h-5 inline mr-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\r\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1\"></path>\r\n                        </svg>\r\n                        Login\r\n                    </a>\r\n                    <a href=\"{% url 'signup' %}\" class=\"px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors\">\r\n                        Sign Up\r\n                    </a>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n    </div>\r\n\r\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8\">\r\n        <div class=\"mb-6\">\r\n<div class=\"flex items-center mb-2\">\r\n  <div class=\"w-14 h-14 bg-amber-500 rounded-xl flex items-center justify-center shadow-lg mr-4 animate-bounce\">\r\n    <i class=\"fas fa-store \"></i>\r\n  </div>\r\n  <h1 class=\"text-3xl font-bold text-gray-800\">Cacao Products Marketplace</h1>\r\n</div>\r\n\r\n\r\n    <p class=\"text-gray-600 ml-18\">Discover and purchase premium cacao products from local farmers</p>\r\n</div>\r\n        <!-- Filters Section -->\r\n        <div class=\"bg-white rounded-xl shadow-sm p-6 mb-8\">\r\n            <form method=\"GET\" class=\"space-y-4\">\r\n                <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\r\n                    <!-- Search -->\r\n                    <div>\r\n                        <label class=\"block text-sm font-medium text-gray-700 mb-2\">Search Products</label>\r\n                        <input type=\"text\" name=\"search\" value=\"{{ current_search }}\" \r\n                               placeholder=\"Search cacao products...\" \r\n                               class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent\">\r\n                    </div>\r\n                    \r\n                    <!-- Category Filter -->\r\n                    <!-- <div>\r\n                        <label class=\"block text-sm font-medium text-gray-700 mb-2\">Category</label>\r\n                        <select name=\"category\" class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent\">\r\n                            <option value=\"\">All Categories</option>\r\n                            {% for category in categories %}\r\n                            <option value=\"{{ category }}\" {% if category == current_category %}selected{% endif %}>\r\n                                {{ category|title }}\r\n                            </option>\r\n                            {% endfor %}\r\n                        </select>\r\n                    </div> -->\r\n                    \r\n                    <!-- Product Type Filter -->\r\n                    <!-- <div>\r\n                        <label class=\"block text-sm font-medium text-gray-700 mb-2\">Product Type</label>\r\n                        <select name=\"type\" class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent\">\r\n                            <option value=\"\">All Types</option>\r\n                            {% for type_value, type_label in product_types %}\r\n                            <option value=\"{{ type_value }}\" {% if type_value == current_type %}selected{% endif %}>\r\n                                {{ type_label }}\r\n                            </option>\r\n                            {% endfor %}\r\n                        </select>\r\n                    </div> -->\r\n                    \r\n                    <!-- Sort -->\r\n                    <!-- <div>\r\n                        <label class=\"block text-sm font-medium text-gray-700 mb-2\">Sort By</label>\r\n                        <select name=\"sort\" class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent\">\r\n                            <option value=\"name\" {% if current_sort == 'name' %}selected{% endif %}>Name</option>\r\n                            <option value=\"price_low\" {% if current_sort == 'price_low' %}selected{% endif %}>Price: Low to High</option>\r\n                            <option value=\"price_high\" {% if current_sort == 'price_high' %}selected{% endif %}>Price: High to Low</option>\r\n                            <option value=\"newest\" {% if current_sort == 'newest' %}selected{% endif %}>Newest First</option>\r\n                        </select>\r\n                    </div> -->\r\n                </div>\r\n                \r\n                <div class=\"flex flex-wrap gap-2\">\r\n                    <button type=\"submit\" class=\"px-6 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 transition-colors\">\r\n                        Apply Filters\r\n                    </button>\r\n                    <a href=\"{% url 'guest_marketplace' %}\" class=\"px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors\">\r\n                        Clear All\r\n                    </a>\r\n                </div>\r\n            </form>\r\n        </div>\r\n\r\n        <!-- Login Notice -->\r\n        <div class=\"bg-blue-50 border border-blue-200 rounded-xl p-4 mb-8\">\r\n            <div class=\"flex items-center\">\r\n                <svg class=\"w-5 h-5 text-blue-600 mr-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\r\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\r\n                </svg>\r\n                <p class=\"text-blue-800\">\r\n                    <a href=\"{% url 'login' %}\" class=\"font-medium underline\">Login</a> or \r\n                    <a href=\"{% url 'signup' %}\" class=\"font-medium underline\">Create Account</a> \r\n                    to add products to cart and place orders.\r\n                </p>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Products Grid -->\r\n        <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6\">\r\n            {% for product in products %}\r\n            <div class=\"product-card bg-white rounded-xl shadow-sm overflow-hidden\">\r\n                <!-- Product Image -->\r\n                <div class=\"aspect-w-1 aspect-h-1 bg-gray-200\">\r\n                    {% if product.images %}\r\n                    <img src=\"{{ product.images.0 }}\" alt=\"{{ product.name }}\" \r\n                         class=\"w-full h-48 object-cover\">\r\n                    {% else %}\r\n                    <div class=\"w-full h-48 bg-gradient-to-br from-amber-100 to-orange-100 flex items-center justify-center\">\r\n                        <svg class=\"w-16 h-16 text-amber-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\r\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\"></path>\r\n                        </svg>\r\n                    </div>\r\n                    {% endif %}\r\n                </div>\r\n                \r\n                <!-- Product Info -->\r\n                <div class=\"p-4\">\r\n                    <div class=\"flex items-start justify-between mb-2\">\r\n                        <h3 class=\"text-lg font-semibold text-gray-900 line-clamp-2\">{{ product.name }}</h3>\r\n                        {% if product.featured %}\r\n                        <span class=\"bg-amber-100 text-amber-800 text-xs px-2 py-1 rounded-full\">Featured</span>\r\n                        {% endif %}\r\n                    </div>\r\n                    \r\n                    <p class=\"text-gray-600 text-sm mb-3 line-clamp-2\">{{ product.description }}</p>\r\n                    \r\n                    <!-- Product Details -->\r\n                    <div class=\"space-y-2 mb-4\">\r\n                        <div class=\"flex items-center text-sm text-gray-500\">\r\n                            <svg class=\"w-4 h-4 mr-1\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\r\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.99 1.99 0 013 12V7a4 4 0 014-4z\"></path>\r\n                            </svg>\r\n                            {{ product.product_type|title }}\r\n                        </div>\r\n                        \r\n                        {% if product.origin %}\r\n                        <div class=\"flex items-center text-sm text-gray-500\">\r\n                            <svg class=\"w-4 h-4 mr-1\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\r\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z\"></path>\r\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 11a3 3 0 11-6 0 3 3 0 016 0z\"></path>\r\n                            </svg>\r\n                            {{ product.origin }}\r\n                        </div>\r\n                        {% endif %}\r\n                        \r\n                        <div class=\"flex items-center text-sm text-gray-500\">\r\n                            <svg class=\"w-4 h-4 mr-1\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\r\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4\"></path>\r\n                            </svg>\r\n                            Stock: {{ product.stock_quantity }} {{ product.unit }}\r\n                        </div>\r\n                    </div>\r\n                    \r\n                    <!-- Price and Actions -->\r\n                    <div class=\"flex items-center justify-between\">\r\n                        <div>\r\n                            <span class=\"text-2xl font-bold text-amber-600\">₱{{ product.price }}</span>\r\n                            <span class=\"text-sm text-gray-500\">/ {{ product.unit }}</span>\r\n                        </div>\r\n                        \r\n                        <div class=\"flex space-x-2\">\r\n                            <a href=\"{% url 'guest_product_detail' product.id %}\" \r\n                               class=\"px-3 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors text-sm\">\r\n                                View\r\n                            </a>\r\n                            \r\n                            <button onclick=\"showLoginModal()\" \r\n                                    class=\"px-3 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 transition-colors text-sm\">\r\n                                Add to Cart\r\n                            </button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            {% empty %}\r\n            <div class=\"col-span-full text-center py-12\">\r\n                <svg class=\"w-16 h-16 text-gray-400 mx-auto mb-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\r\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4\"></path>\r\n                </svg>\r\n                <h3 class=\"text-lg font-medium text-gray-900 mb-2\">No products found</h3>\r\n                <p class=\"text-gray-500\">Try adjusting your search criteria or browse all products.</p>\r\n            </div>\r\n            {% endfor %}\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n<!-- Login Modal -->\r\n<div id=\"loginModal\" class=\"fixed inset-0 login-overlay hidden items-center justify-center z-50\">\r\n    <div class=\"bg-white rounded-lg p-6 max-w-md mx-4\">\r\n        <div class=\"text-center\">\r\n            <div class=\"w-12 h-12 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-4\">\r\n                <svg class=\"w-6 h-6 text-amber-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\r\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\"></path>\r\n                </svg>\r\n            </div>\r\n            <h3 class=\"text-lg font-medium text-gray-900 mb-2\">Login Required</h3>\r\n            <p class=\"text-gray-500 mb-6\">Please login to add products to cart and place orders.</p>\r\n            <div class=\"flex space-x-3\">\r\n                <button onclick=\"closeLoginModal()\" class=\"flex-1 px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors\">\r\n                    Cancel\r\n                </button>\r\n                <a href=\"{% url 'login' %}\" class=\"flex-1 px-4 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 transition-colors text-center\">\r\n                    Login\r\n                </a>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n<script>\r\nfunction showLoginModal() {\r\n    document.getElementById('loginModal').classList.remove('hidden');\r\n    document.getElementById('loginModal').classList.add('flex');\r\n}\r\n\r\nfunction closeLoginModal() {\r\n    document.getElementById('loginModal').classList.add('hidden');\r\n    document.getElementById('loginModal').classList.remove('flex');\r\n}\r\n\r\n// Close modal when clicking outside\r\ndocument.getElementById('loginModal').addEventListener('click', function(e) {\r\n    if (e.target === this) {\r\n        closeLoginModal();\r\n    }\r\n});\r\n</script>\r\n{% endblock %}\r\n"
        }
    ]
}