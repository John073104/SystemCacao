            "name": "Commit-0",
            "content": "{% load static %}<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>User Dashboard - CacaoGuard</title>\r\n    \r\n    <!-- Favicon -->\r\n    <link rel=\"icon\" type=\"image/png\" href=\"{% static 'images/NOBGHERO.png' %}\">\r\n    <link rel=\"apple-touch-icon\" href=\"{% static 'images/NOBGHERO.png' %}\">\r\n    \r\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\r\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" rel=\"stylesheet\">\r\n    <link rel=\"stylesheet\" href=\"{% static 'css/gradients.css' %}\">\r\n    <script src=\"https://cdn.tailwindcss.com\"></script>\r\n    <script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\r\n    <script src=\"https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js\" defer></script>\r\n    <style>\r\n        body { font-family: 'Inter', sans-serif; background: linear-gradient(135deg, #fef3e2 0%, #f3e8ff 50%, #e0f2fe 100%); }\r\n        .glass-card { background: rgba(255, 255, 255, 0.9); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.2); }\r\n        .stat-card { transition: all 0.3s ease; }\r\n        .stat-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(0,0,0,0.1); }\r\n        .icon-gradient-1 { background: linear-gradient(135deg, #f59e0b 0%, #f97316 100%); }\r\n        .icon-gradient-2 { background: linear-gradient(135deg, #d946ef 0%, #a855f7 100%); }\r\n        .icon-gradient-3 { background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%); }\r\n        .icon-gradient-4 { background: linear-gradient(135deg, #10b981 0%, #059669 100%); }\r\n        .icon-gradient-5 { background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); }\r\n        .history-card { transition: all 0.3s ease; border-left: 4px solid transparent; }\r\n        .history-card:hover { transform: translateX(5px); border-left-color: #06b6d4; background: rgba(6, 182, 212, 0.05); }\r\n        .scan-history-section { max-height: 500px; overflow-y: auto; }\r\n        .scan-history-section::-webkit-scrollbar { width: 6px; }\r\n        .scan-history-section::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.1); border-radius: 3px; }\r\n        .scan-history-section::-webkit-scrollbar-thumb { background: rgba(6, 182, 212, 0.3); border-radius: 3px; }\r\n        .scan-history-section::-webkit-scrollbar-thumb:hover { background: rgba(6, 182, 212, 0.5); }\r\n        .order-card { transition: all 0.3s ease; border-left: 4px solid transparent; }\r\n        .order-card:hover { transform: translateX(5px); border-left-color: #8b5cf6; background: rgba(139, 92, 246, 0.05); }\r\n        .farm-card { transition: all 0.3s ease; border-left: 4px solid transparent; }\r\n        .farm-card:hover { transform: translateX(5px); border-left-color: #10b981; background: rgba(16, 185, 129, 0.05); }\r\n        @media print { .no-print { display: none !important; } .print-only { display: block !important; } body { background: white !important; } .glass-card { background: white !important; border: 1px solid #ccc !important; } }\r\n        .print-only { display: none; }\r\n    </style>\r\n    <script>\r\n        tailwind.config = {\r\n            theme: {\r\n                extend: {\r\n                    fontFamily: { 'inter': ['Inter', 'sans-serif'] },\r\n                    animation: { 'fade-in': 'fadeIn 0.6s ease-out', 'slide-up': 'slideUp 0.5s ease-out', 'float': 'float 3s ease-in-out infinite' },\r\n                    keyframes: {\r\n                        fadeIn: { '0%': { opacity: '0', transform: 'translateY(20px)' }, '100%': { opacity: '1', transform: 'translateY(0)' } },\r\n                        slideUp: { '0%': { opacity: '0', transform: 'translateY(30px)' }, '100%': { opacity: '1', transform: 'translateY(0)' } },\r\n                        float: { '0%, 100%': { transform: 'translateY(0px)' }, '50%': { transform: 'translateY(-10px)' } }\r\n                    }\r\n                }\r\n            }\r\n        }\r\n    </script>\r\n</head>\r\n<body class=\"bg-gray-100 font-sans\">\r\n    <div class=\"flex h-screen overflow-hidden\">\r\n        {% include 'user/sidebar.html' %}\r\n        <div class=\"flex-1 overflow-y-auto\">\r\n            <!-- Add padding for mobile menu button -->\r\n            <div class=\"p-4 lg:p-8 pt-16 lg:pt-8\">\r\n            {% block content %}\r\n            <div class=\"user-header-gradient p-6 rounded-2xl shadow-lg mb-8 animate-fade-in\">\r\n                <div class=\"flex items-center justify-between\">\r\n                    <div class=\"flex items-center space-x-4\">\r\n                        <div class=\"w-16 h-16 icon-gradient-3 rounded-2xl flex items-center justify-center animate-float\">\r\n                            <i class=\"fas fa-seedling text-white text-2xl\"></i>\r\n                        </div>\r\n                        <div>\r\n                            <h1 class=\"text-3xl font-bold text-white\">CacaoGuard User</h1>\r\n                            <p class=\"text-green-100\">User Dashboard</p>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"flex items-center space-x-4\">\r\n                        <!-- Notification Bell -->\r\n                        <div x-data=\"notificationDropdown()\" class=\"relative\">\r\n                            <button @click=\"toggleDropdown()\" class=\"relative p-2 bg-white/20 backdrop-blur-md text-white rounded-full hover:bg-white/30 transition\">\r\n                                <i class=\"fas fa-bell text-xl\"></i>\r\n                                <span x-show=\"unreadCount > 0\" x-text=\"unreadCount\" class=\"absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center font-bold\"></span>\r\n                            </button>\r\n                            \r\n                            <!-- Dropdown -->\r\n                            <div x-show=\"open\" @click.away=\"open = false\" x-transition class=\"absolute right-0 mt-2 w-80 bg-white rounded-lg shadow-xl overflow-hidden z-50\">\r\n                                <div class=\"bg-gradient-to-r from-cyan-600 to-blue-600 px-4 py-3 flex items-center justify-between\">\r\n                                    <h3 class=\"text-white font-semibold\">Notifications</h3>\r\n                                    <button @click=\"markAllRead()\" class=\"text-white text-xs hover:underline\">Mark all read</button>\r\n                                </div>\r\n                                <div class=\"max-h-96 overflow-y-auto\">\r\n                                    <template x-if=\"notifications.length === 0\">\r\n                                        <div class=\"p-4 text-center text-gray-500\">\r\n                                            <i class=\"fas fa-bell-slash text-3xl mb-2\"></i>\r\n                                            <p>No notifications</p>\r\n                                        </div>\r\n                                    </template>\r\n                                    <template x-for=\"notif in notifications\" :key=\"notif.id\">\r\n                                        <div @click=\"markRead(notif.id)\" :class=\"notif.read ? 'bg-white' : 'bg-blue-50'\" class=\"px-4 py-3 border-b hover:bg-gray-50 cursor-pointer\">\r\n                                            <div class=\"flex items-start\">\r\n                                                <i :class=\"getNotificationIcon(notif.type)\" class=\"mt-1 mr-3\"></i>\r\n                                                <div class=\"flex-1\">\r\n                                                    <h4 class=\"font-semibold text-sm text-gray-800\" x-text=\"notif.title\"></h4>\r\n                                                    <p class=\"text-xs text-gray-600 mt-1\" x-text=\"notif.message\"></p>\r\n                                                    <p class=\"text-xs text-gray-400 mt-1\" x-text=\"formatTime(notif.created_at)\"></p>\r\n                                                </div>\r\n                                                <span x-show=\"!notif.read\" class=\"w-2 h-2 bg-blue-500 rounded-full\"></span>\r\n                                            </div>\r\n                                        </div>\r\n                                    </template>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        \r\n                        <span class=\"px-4 py-2 bg-white/20 backdrop-blur-md text-white rounded-full text-sm font-medium border border-white/30\">\r\n                            <i class=\"fas fa-circle text-green-300 mr-1\"></i>System Online\r\n                        </span>\r\n                        <div class=\"text-right bg-white/10 backdrop-blur-md px-4 py-3 rounded-xl border border-white/20\">\r\n                            <p class=\"text-sm text-white font-medium\" id=\"current-time\">Loading...</p>\r\n                            <p class=\"text-xs text-green-100\">Philippines</p>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"print-only mb-8\">\r\n                <div class=\"text-center border-b pb-4 mb-4\">\r\n                    <h1 class=\"text-2xl font-bold\">CacaoGuard User Dashboard Report</h1>\r\n                    <p class=\"text-gray-600\">Generated on: {{ current_date }} {{ current_time }}</p>\r\n                    <p class=\"text-gray-600\">User: {{ name }} ({{ email }})</p>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-8\">\r\n                <div class=\"glass-card p-6 rounded-2xl shadow-md stat-card hover:shadow-lg\">\r\n                    <div class=\"flex items-center justify-between\">\r\n                        <div>\r\n                            <p class=\"text-sm font-medium text-gray-500\">Total Orders</p>\r\n                            <p class=\"text-3xl font-bold text-gray-900 mt-2\" id=\"total-orders-count\">{{ total_orders }}</p>\r\n                            <p class=\"text-xs text-gray-400 mt-1\">Your marketplace purchases</p>\r\n                            <div class=\"mt-2\">\r\n                                <span class=\"text-xs bg-yellow-100 text-yellow-800 px-2 py-1 rounded\">Pending: {{ pending_orders }}</span>\r\n                                <span class=\"text-xs bg-green-100 text-green-800 px-2 py-1 rounded ml-1\">Delivered: {{ delivered_orders }}</span>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"w-14 h-14 icon-gradient-5 rounded-xl flex items-center justify-center\">\r\n                            <i class=\"fas fa-shopping-bag text-white text-xl\"></i>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"glass-card p-6 rounded-2xl shadow-md stat-card hover:shadow-lg\">\r\n                    <div class=\"flex items-center justify-between\">\r\n                        <div>\r\n                            <p class=\"text-sm font-medium text-gray-500\">Total Scans</p>\r\n                            <p class=\"text-3xl font-bold text-gray-900 mt-2\" id=\"total-scans-count\">{{ total_scans }}</p>\r\n                            <p class=\"text-xs text-gray-400 mt-1\">Disease detections</p>\r\n                            <div class=\"mt-2\">\r\n                                <span class=\"text-xs bg-red-100 text-red-800 px-2 py-1 rounded\">Disease: {{ disease_scans }}</span>\r\n                                <span class=\"text-xs bg-orange-100 text-orange-800 px-2 py-1 rounded ml-1\">Pest: {{ pest_scans }}</span>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"w-14 h-14 icon-gradient-2 rounded-xl flex items-center justify-center\">\r\n                            <i class=\"fas fa-microscope text-white text-xl\"></i>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"glass-card p-6 rounded-2xl shadow-md stat-card hover:shadow-lg\">\r\n                    <div class=\"flex items-center justify-between\">\r\n                        <div>\r\n                            <p class=\"text-sm font-medium text-gray-500\">Total Maps</p>\r\n                            <p class=\"text-3xl font-bold text-gray-900 mt-2\" id=\"total-maps-count\">{{ total_maps }}</p>\r\n                            <p class=\"text-xs text-gray-400 mt-1\">Farm locations</p>\r\n                            <div class=\"mt-2\">\r\n                                <span class=\"text-xs bg-green-100 text-green-800 px-2 py-1 rounded\">Area: <span id=\"user-total-area\">{{ total_farm_area }}</span> ha</span>\r\n                                <span class=\"text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded ml-1\">Trees: <span id=\"user-total-trees\">{{ total_trees }}</span></span>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"w-14 h-14 icon-gradient-4 rounded-xl flex items-center justify-center\">\r\n                            <i class=\"fas fa-map-marked-alt text-white text-xl\"></i>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8 no-print\">\r\n                <div class=\"glass-card p-6 rounded-2xl shadow-md\">\r\n                    <h3 class=\"text-lg font-semibold text-gray-800 mb-4\"><i class=\"fas fa-chart-line text-blue-600 mr-2\"></i>Orders Trend (Last 7 Days)</h3>\r\n                    <canvas id=\"ordersChart\" width=\"400\" height=\"200\"></canvas>\r\n                </div>\r\n                <div class=\"glass-card p-6 rounded-2xl shadow-md\">\r\n                    <h3 class=\"text-lg font-semibold text-gray-800 mb-4\"><i class=\"fas fa-chart-pie text-purple-600 mr-2\"></i>Scan Types Distribution</h3>\r\n                    <div class=\"flex justify-center\"><canvas id=\"scansChart\" width=\"280\" height=\"200\" style=\"max-width: 280px; max-height: 280px;\"></canvas></div>\r\n                </div>\r\n                <div class=\"glass-card p-6 rounded-2xl shadow-md\">\r\n                    <h3 class=\"text-lg font-semibold text-gray-800 mb-4\"><i class=\"fas fa-chart-bar text-green-600 mr-2\"></i>Monthly Activity (Last 6 Months)</h3>\r\n                    <canvas id=\"monthlyChart\" width=\"400\" height=\"200\"></canvas>\r\n                </div>\r\n                <div class=\"glass-card p-6 rounded-2xl shadow-md\">\r\n                    <h3 class=\"text-lg font-semibold text-gray-800 mb-4\"><i class=\"fas fa-chart-doughnut text-orange-600 mr-2\"></i>Order Status Distribution</h3>\r\n                    <div class=\"flex justify-center\"><canvas id=\"orderStatusChart\" width=\"280\" height=\"200\" style=\"max-width: 280px; max-height: 280px;\"></canvas></div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8\">\r\n                <div class=\"glass-card p-6 rounded-2xl shadow-md\">\r\n                    <h3 class=\"text-lg font-semibold text-gray-800 mb-4\"><i class=\"fas fa-shopping-cart text-blue-600 mr-2\"></i>Recent Orders</h3>\r\n                    <div class=\"space-y-3 scan-history-section\">\r\n                        {% for order in recent_orders %}\r\n                        <div class=\"order-card p-3 bg-gray-50 rounded-lg\">\r\n                            <div class=\"flex justify-between items-start\">\r\n                                <div>\r\n                                    <p class=\"font-medium text-sm\">Order #{{ order.order_id }}</p>\r\n                                    <p class=\"text-xs text-gray-500\">{{ order.created_at|date:\"M d, Y H:i\" }}</p>\r\n                                </div>\r\n                                <div class=\"text-right\">\r\n                                    <p class=\"font-semibold text-sm\">₱{{ order.total_amount }}</p>\r\n                                    <span class=\"text-xs px-2 py-1 rounded-full {% if order.status == 'pending' %}bg-yellow-100 text-yellow-800{% elif order.status == 'delivered' %}bg-green-100 text-green-800{% elif order.status == 'cancelled' %}bg-red-100 text-red-800{% else %}bg-gray-100 text-gray-800{% endif %}\">{{ order.status|title }}</span>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        {% empty %}<p class=\"text-gray-500 text-center py-4\">No recent orders</p>{% endfor %}\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"glass-card p-6 rounded-2xl shadow-md\">\r\n                    <h3 class=\"text-lg font-semibold text-gray-800 mb-4\"><i class=\"fas fa-microscope text-purple-600 mr-2\"></i>Recent Scans</h3>\r\n                    <div class=\"space-y-3 scan-history-section\">\r\n                        {% for scan in recent_scans %}\r\n                        <div class=\"history-card p-3 bg-gray-50 rounded-lg\">\r\n                            <div class=\"flex justify-between items-start\">\r\n                                <div>\r\n                                    <p class=\"font-medium text-sm\">{{ scan.result }}</p>\r\n                                    <p class=\"text-xs text-gray-500\">{{ scan.timestamp|date:\"M d, Y H:i\" }}</p>\r\n                                </div>\r\n                                <div class=\"text-right\">\r\n                                    <p class=\"font-semibold text-sm\">{{ scan.confidence }}%</p>\r\n                                    <span class=\"text-xs px-2 py-1 rounded-full {% if scan.type == 'disease' %}bg-red-100 text-red-800{% else %}bg-orange-100 text-orange-800{% endif %}\">{{ scan.type|title }}</span>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        {% empty %}<p class=\"text-gray-500 text-center py-4\">No recent scans</p>{% endfor %}\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"glass-card p-6 rounded-2xl shadow-md\">\r\n                    <h3 class=\"text-lg font-semibold text-gray-800 mb-4\"><i class=\"fas fa-map text-green-600 mr-2\"></i>Farm Overview</h3>\r\n                    <div class=\"space-y-3 scan-history-section\">\r\n                        {% for farm in recent_farms %}\r\n                        <div class=\"farm-card p-3 bg-gray-50 rounded-lg\">\r\n                            <div class=\"flex justify-between items-start\">\r\n                                <div>\r\n                                    <p class=\"font-medium text-sm\">{{ farm.name }}</p>\r\n                                    <p class=\"text-xs text-gray-500\">{{ farm.municipality }}, {{ farm.barangay }}</p>\r\n                                </div>\r\n                                <div class=\"text-right\">\r\n                                    <p class=\"font-semibold text-sm\">{{ farm.area }} ha</p>\r\n                                    <p class=\"text-xs text-gray-500\">{{ farm.trees }} trees</p>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        {% empty %}<p class=\"text-gray-500 text-center py-4\">No farm data available</p>{% endfor %}\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            {% endblock %}\r\n        </div>\r\n    </div>\r\n\r\n    <script>\r\n        function safeParseJSON(jsonString, defaultValue = {}) {\r\n            try { return JSON.parse(jsonString); } catch (e) { console.warn('Failed to parse JSON:', e); return defaultValue; }\r\n        }\r\n        function initializeTime() {\r\n            const timeElement = document.getElementById('current-time');\r\n            if (timeElement) { const now = new Date(); timeElement.textContent = now.toLocaleString(); }\r\n        }\r\n        function updateTime() {\r\n            const timeElement = document.getElementById('current-time');\r\n            if (timeElement) { const now = new Date(); timeElement.textContent = now.toLocaleString(); }\r\n        }\r\n        function updateDashboard() {\r\n            fetch('/dashboard-api/').then(response => response.json()).then(data => {\r\n                if (data.success && data.data) {\r\n                    const ordersCount = document.getElementById('total-orders-count');\r\n                    const scansCount = document.getElementById('total-scans-count');\r\n                    const mapsCount = document.getElementById('total-maps-count');\r\n                    if (ordersCount) ordersCount.textContent = data.data.total_orders || 0;\r\n                    if (scansCount) scansCount.textContent = data.data.total_scans || 0;\r\n                    if (mapsCount) mapsCount.textContent = data.data.total_maps || 0;\r\n                    console.log('Dashboard updated at:', data.data.timestamp);\r\n                    showUpdateIndicator();\r\n                }\r\n            }).catch(error => console.error('Error updating dashboard:', error));\r\n        }\r\n        function printDashboard() { window.print(); }\r\n        function showUpdateIndicator() {\r\n            const indicator = document.createElement('div');\r\n            indicator.className = 'fixed top-4 right-4 bg-green-500 text-white px-4 py-2 rounded-lg shadow-lg z-50';\r\n            indicator.textContent = 'Dashboard Updated';\r\n            document.body.appendChild(indicator);\r\n            setTimeout(() => { indicator.remove(); }, 2000);\r\n        }\r\n        document.addEventListener('DOMContentLoaded', function() {\r\n            initializeTime();\r\n            setInterval(updateTime, 1000);\r\n            setInterval(updateDashboard, 30000);\r\n\r\n            try {\r\n                const ordersChartElement = document.getElementById('ordersChart');\r\n                if (ordersChartElement) {\r\n                    const ordersCtx = ordersChartElement.getContext('2d');\r\n                    const ordersData = safeParseJSON('{{ orders_chart_data|safe }}', []);\r\n                    if (Array.isArray(ordersData) && ordersData.length > 0) {\r\n                        new Chart(ordersCtx, {\r\n                            type: 'line',\r\n                            data: { labels: ordersData.map(d => d.label || ''), datasets: [{ label: 'Orders', data: ordersData.map(d => d.count || 0), borderColor: 'rgb(59, 130, 246)', backgroundColor: 'rgba(59, 130, 246, 0.1)', tension: 0.4, fill: true, pointBackgroundColor: 'rgb(59, 130, 246)', pointBorderColor: '#fff', pointBorderWidth: 2, pointRadius: 5 }] },\r\n                            options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }\r\n                        });\r\n                    }\r\n                }\r\n            } catch (e) { console.error('Error initializing Orders Chart:', e); }\r\n\r\n            try {\r\n                const scansChartElement = document.getElementById('scansChart');\r\n                if (scansChartElement) {\r\n                    const scansCtx = scansChartElement.getContext('2d');\r\n                    const scansData = safeParseJSON('{{ scan_distribution|safe }}', { disease: 0, pest: 0 });\r\n                    new Chart(scansCtx, {\r\n                        type: 'doughnut',\r\n                        data: { labels: ['Disease Scans', 'Pest Scans'], datasets: [{ data: [scansData.disease || 0, scansData.pest || 0], backgroundColor: ['rgba(239, 68, 68, 0.8)', 'rgba(245, 158, 11, 0.8)'], borderColor: ['rgb(239, 68, 68)', 'rgb(245, 158, 11)'], borderWidth: 2 }] },\r\n                        options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { position: 'bottom', labels: { padding: 15, usePointStyle: true, font: { size: 11 } } } } }\r\n                    });\r\n                }\r\n            } catch (e) { console.error('Error initializing Scans Chart:', e); }\r\n\r\n            try {\r\n                const monthlyChartElement = document.getElementById('monthlyChart');\r\n                if (monthlyChartElement) {\r\n                    const monthlyCtx = monthlyChartElement.getContext('2d');\r\n                    const monthlyData = safeParseJSON('{{ monthly_chart_data|safe }}', { labels: [], orders: [], scans: [] });\r\n                    new Chart(monthlyCtx, {\r\n                        type: 'bar',\r\n                        data: { labels: monthlyData.labels || [], datasets: [{ label: 'Orders', data: monthlyData.orders || [], backgroundColor: 'rgba(59, 130, 246, 0.7)', borderColor: 'rgb(59, 130, 246)', borderWidth: 1 }, { label: 'Scans', data: monthlyData.scans || [], backgroundColor: 'rgba(168, 85, 247, 0.7)', borderColor: 'rgb(168, 85, 247)', borderWidth: 1 }] },\r\n                        options: { responsive: true, plugins: { legend: { position: 'top', labels: { padding: 15, usePointStyle: true } } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }\r\n                    });\r\n                }\r\n            } catch (e) { console.error('Error initializing Monthly Chart:', e); }\r\n\r\n            try {\r\n                const orderStatusChartElement = document.getElementById('orderStatusChart');\r\n                if (orderStatusChartElement) {\r\n                    const orderStatusCtx = orderStatusChartElement.getContext('2d');\r\n                    const orderStatusData = safeParseJSON('{{ order_status_distribution|safe }}', { pending: 0, processing: 0, delivered: 0, cancelled: 0 });\r\n                    new Chart(orderStatusCtx, {\r\n                        type: 'doughnut',\r\n                        data: { labels: ['Pending', 'Processing', 'Delivered', 'Cancelled'], datasets: [{ data: [orderStatusData.pending || 0, orderStatusData.processing || 0, orderStatusData.delivered || 0, orderStatusData.cancelled || 0], backgroundColor: ['rgba(245, 158, 11, 0.8)', 'rgba(59, 130, 246, 0.8)', 'rgba(16, 185, 129, 0.8)', 'rgba(239, 68, 68, 0.8)'], borderColor: ['rgb(245, 158, 11)', 'rgb(59, 130, 246)', 'rgb(16, 185, 129)', 'rgb(239, 68, 68)'], borderWidth: 2 }] },\r\n                        options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { position: 'bottom', labels: { padding: 15, usePointStyle: true, font: { size: 11 } } } } }\r\n                    });\r\n                }\r\n            } catch (e) { console.error('Error initializing Order Status Chart:', e); }\r\n        });\r\n        \r\n        // Notification Dropdown Component\r\n        function notificationDropdown() {\r\n            return {\r\n                open: false,\r\n                notifications: [],\r\n                unreadCount: 0,\r\n                \r\n                toggleDropdown() {\r\n                    this.open = !this.open;\r\n                    if (this.open) {\r\n                        this.fetchNotifications();\r\n                    }\r\n                },\r\n                \r\n                async fetchNotifications() {\r\n                    try {\r\n                        const response = await fetch('/api/notifications/?limit=10');\r\n                        const data = await response.json();\r\n                        if (data.success) {\r\n                            this.notifications = data.notifications;\r\n                            this.unreadCount = data.unread_count;\r\n                        }\r\n                    } catch (error) {\r\n                        console.error('Error fetching notifications:', error);\r\n                    }\r\n                },\r\n                \r\n                async markRead(notifId) {\r\n                    try {\r\n                        const response = await fetch('/api/notifications/mark-read/', {\r\n                            method: 'POST',\r\n                            headers: {\r\n                                'Content-Type': 'application/json',\r\n                                'X-CSRFToken': this.getCookie('csrftoken')\r\n                            },\r\n                            body: JSON.stringify({ notification_id: notifId })\r\n                        });\r\n                        if (response.ok) {\r\n                            this.fetchNotifications();\r\n                        }\r\n                    } catch (error) {\r\n                        console.error('Error marking notification as read:', error);\r\n                    }\r\n                },\r\n                \r\n                async markAllRead() {\r\n                    try {\r\n                        const response = await fetch('/api/notifications/mark-all-read/', {\r\n                            method: 'POST',\r\n                            headers: {\r\n                                'Content-Type': 'application/json',\r\n                                'X-CSRFToken': this.getCookie('csrftoken')\r\n                            }\r\n                        });\r\n                        if (response.ok) {\r\n                            this.fetchNotifications();\r\n                        }\r\n                    } catch (error) {\r\n                        console.error('Error marking all as read:', error);\r\n                    }\r\n                },\r\n                \r\n                getNotificationIcon(type) {\r\n                    const icons = {\r\n                        'order_status': 'fas fa-shopping-cart text-blue-500',\r\n                        'success': 'fas fa-check-circle text-green-500',\r\n                        'warning': 'fas fa-exclamation-triangle text-yellow-500',\r\n                        'error': 'fas fa-exclamation-circle text-red-500',\r\n                        'info': 'fas fa-info-circle text-blue-500'\r\n                    };\r\n                    return icons[type] || icons['info'];\r\n                },\r\n                \r\n                formatTime(timestamp) {\r\n                    if (!timestamp) return '';\r\n                    const date = new Date(timestamp);\r\n                    const now = new Date();\r\n                    const diff = Math.floor((now - date) / 1000); // seconds\r\n                    \r\n                    if (diff < 60) return 'Just now';\r\n                    if (diff < 3600) return Math.floor(diff / 60) + ' min ago';\r\n                    if (diff < 86400) return Math.floor(diff / 3600) + ' hours ago';\r\n                    return Math.floor(diff / 86400) + ' days ago';\r\n                },\r\n                \r\n                getCookie(name) {\r\n                    let cookieValue = null;\r\n                    if (document.cookie && document.cookie !== '') {\r\n                        const cookies = document.cookie.split(';');\r\n                        for (let i = 0; i < cookies.length; i++) {\r\n                            const cookie = cookies[i].trim();\r\n                            if (cookie.substring(0, name.length + 1) === (name + '=')) {\r\n                                cookieValue = decodeURIComponent(cookie.substring(name.length + 1));\r\n                                break;\r\n                            }\r\n                        }\r\n                    }\r\n                    return cookieValue;\r\n                },\r\n                \r\n                init() {\r\n                    // Fetch notifications on page load\r\n                    this.fetchNotifications();\r\n                    // Poll for new notifications every 30 seconds\r\n                    setInterval(() => {\r\n                        if (!this.open) {\r\n                            this.fetchNotifications();\r\n                        }\r\n                    }, 30000);\r\n                }\r\n            }\r\n        }\r\n    </script>\r\n    </div>\r\n        </div>\r\n    </div>\r\n</body>\r\n</html>\r\n"
        }
