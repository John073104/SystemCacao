            "date": 1762513881697,
            "name": "Commit-0",
            "content": "{% extends \"user/userdashboard.html\" %}\r\n{% load static %}\r\n\r\n{% block title %}Order Confirmation - {{ order.order_id }}{% endblock %}\r\n\r\n{% block content %}\r\n<div class=\"min-h-screen bg-gradient-to-br from-amber-50 to-orange-50\">\r\n    <div class=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8\">\r\n        <!-- Success Message -->\r\n        <div class=\"bg-green-50 border border-green-200 rounded-lg p-6 mb-8\">\r\n            <div class=\"flex items-center\">\r\n                <svg class=\"w-8 h-8 text-green-600 mr-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\r\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\r\n                </svg>\r\n                <div>\r\n                    <h1 class=\"text-2xl font-bold text-green-800\">Order Placed Successfully!</h1>\r\n                    <p class=\"text-green-700 mt-1\">Order #{{ order.order_id }} has been received and is being processed.</p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Order Summary -->\r\n        <div class=\"bg-white rounded-xl shadow-sm overflow-hidden mb-8\">\r\n            <div class=\"px-6 py-4 bg-gray-50 border-b\">\r\n                <h2 class=\"text-xl font-semibold text-gray-900\">Order Summary</h2>\r\n                <p class=\"text-sm text-gray-500\">\r\n                    {% if order.created_at %}\r\n                        Placed on {{ order.created_at|date:\"F d, Y\" }} at {{ order.created_at|time:\"g:i A\" }}\r\n                    {% endif %}\r\n                </p>\r\n            </div>\r\n\r\n            <!-- Order Items -->\r\n            <div class=\"px-6 py-6\">\r\n                <div class=\"space-y-4\">\r\n                    {% for item in order.items %}\r\n                    <div class=\"flex items-center space-x-4 p-4 bg-gray-50 rounded-lg\">\r\n                        <div class=\"flex-shrink-0\">\r\n                            <div class=\"w-16 h-16 bg-gradient-to-br from-amber-100 to-orange-100 rounded-lg flex items-center justify-center\">\r\n                                <svg class=\"w-8 h-8 text-amber-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\r\n                                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4\"></path>\r\n                                </svg>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"flex-1\">\r\n                            <h4 class=\"text-lg font-medium text-gray-900\">{{ item.product_name }}</h4>\r\n                            <p class=\"text-sm text-gray-500\">Quantity: {{ item.quantity }}</p>\r\n                            <p class=\"text-sm text-gray-500\">Price: ₱{{ item.price|floatformat:2 }} each</p>\r\n                        </div>\r\n                        <div class=\"text-right\">\r\n                            <div class=\"text-lg font-medium text-gray-900\">₱{{ item.total_price|floatformat:2 }}</div>\r\n                        </div>\r\n                    </div>\r\n                    {% endfor %}\r\n                </div>\r\n            </div>\r\n\r\n            <!-- Total -->\r\n            <div class=\"px-6 py-4 bg-gray-50 border-t\">\r\n                <div class=\"flex justify-between items-center\">\r\n                    <span class=\"text-lg font-medium text-gray-900\">Total Amount</span>\r\n                    <span class=\"text-2xl font-bold text-gray-900\">₱{{ order.total_amount|floatformat:2 }}</span>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Payment Instructions -->\r\n        {% if order.payment_method == 'gcash' %}\r\n        <div class=\"bg-blue-50 border-2 border-blue-300 rounded-lg p-6 mb-8\">\r\n            <div class=\"flex items-start\">\r\n                <svg class=\"w-8 h-8 text-blue-600 mr-3 flex-shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\r\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z\"></path>\r\n                </svg>\r\n                <div class=\"flex-1\">\r\n                    <h3 class=\"text-lg font-semibold text-blue-800 mb-3\">GCash Payment Instructions</h3>\r\n                    <div class=\"bg-white rounded-lg p-4 mb-3\">\r\n                        <div class=\"space-y-2\">\r\n                            <div class=\"flex justify-between items-center border-b pb-2\">\r\n                                <span class=\"text-gray-600\">Amount to Pay:</span>\r\n                                <span class=\"text-xl font-bold text-blue-700\">₱{{ order.total_amount|floatformat:2 }}</span>\r\n                            </div>\r\n                            <div class=\"flex justify-between items-center\">\r\n                                <span class=\"text-gray-600\">GCash Number:</span>\r\n                                <span class=\"font-mono font-bold text-lg text-gray-900\">09123456789</span>\r\n                            </div>\r\n                            <div class=\"flex justify-between items-center\">\r\n                                <span class=\"text-gray-600\">Account Name:</span>\r\n                                <span class=\"font-medium text-gray-900\">CacaoGuard Marketplace</span>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"bg-amber-50 border border-amber-200 rounded-lg p-4 mb-3\">\r\n                        <p class=\"text-sm text-amber-800 font-semibold mb-2\">📱 How to Pay via GCash:</p>\r\n                        <ol class=\"text-sm text-amber-900 space-y-1 list-decimal list-inside\">\r\n                            <li>Open your GCash app</li>\r\n                            <li>Send money to: <strong>09123456789</strong></li>\r\n                            <li>Enter amount: <strong>₱{{ order.total_amount|floatformat:2 }}</strong></li>\r\n                            <li>In the message field, write: <strong>Order #{{ order.order_id }}</strong></li>\r\n                            <li>Take a screenshot of the payment confirmation</li>\r\n                            <li>Contact admin to upload payment proof</li>\r\n                        </ol>\r\n                    </div>\r\n                    <p class=\"text-sm text-blue-700\">\r\n                        ⏰ <strong>Important:</strong> Your order will be confirmed once we verify your payment. \r\n                        Please send proof of payment to our admin.\r\n                    </p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        {% else %}\r\n        <!-- Next Steps for COD -->\r\n        <div class=\"bg-blue-50 border border-blue-200 rounded-lg p-6 mb-8\">\r\n            <h3 class=\"text-lg font-semibold text-blue-800 mb-2\">What's Next?</h3>\r\n            <ul class=\"text-blue-700 space-y-1\">\r\n                <li>• Your Cash on Delivery order is pending confirmation</li>\r\n                <li>• You will receive updates on your order status</li>\r\n                <li>• Prepare exact cash amount for delivery</li>\r\n                <li>• Check your orders page for tracking information</li>\r\n            </ul>\r\n        </div>\r\n        {% endif %}\r\n\r\n        <!-- Action Buttons -->\r\n        <div class=\"flex flex-col sm:flex-row gap-4 justify-center\">\r\n            <a href=\"{% url 'orders' %}\" \r\n               class=\"px-6 py-3 bg-amber-600 text-white rounded-lg hover:bg-amber-700 transition-colors text-center\">\r\n                View My Orders\r\n            </a>\r\n            <a href=\"{% url 'marketplace' %}\" \r\n               class=\"px-6 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors text-center\">\r\n                Continue Shopping\r\n            </a>\r\n        </div>\r\n    </div>\r\n</div>\r\n{% endblock %}\r\n"
        }
    ]
}