            "date": 1762257567824,
            "name": "Commit-0",
            "content": "{% extends \"admin/admin_dashboard.html\" %}\r\n{% load static %}\r\n\r\n{% block title %}Add Product{% endblock %}\r\n\r\n{% block content %}\r\n<div class=\"min-h-screen bg-gray-50\">\r\n    <!-- Header -->\r\n    <div class=\"bg-gradient-to-r from-green-600 via-emerald-600 to-teal-600 text-white shadow-sm border-b\">\r\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6\">\r\n            <div class=\"flex items-center justify-between\">\r\n                <div>\r\n                    <h1 class=\"text-3xl font-bold\">Add New Product</h1>\r\n                    <p class=\"text-emerald-100 mt-1\">Create a new cacao product for your marketplace</p>\r\n                </div>\r\n                \r\n                <a href=\"{% url 'admin_products' %}\" \r\n                   class=\"px-4 py-2 bg-white text-green-700 rounded-lg hover:bg-gray-100 transition-colors\">\r\n                    <svg class=\"w-5 h-5 inline mr-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\r\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M10 19l-7-7m0 0l7-7m-7 7h18\"></path>\r\n                    </svg>\r\n                    Back to Products\r\n                </a>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8\">\r\n        <form method=\"POST\" enctype=\"multipart/form-data\" class=\"space-y-8\">\r\n            {% csrf_token %}\r\n            \r\n            <!-- Basic Information -->\r\n            <div class=\"bg-white rounded-xl shadow-sm p-6\">\r\n                <h3 class=\"text-lg font-semibold text-gray-900 mb-6\">Basic Information</h3>\r\n                \r\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\r\n                    <div class=\"md:col-span-2\">\r\n                        <label for=\"name\" class=\"block text-sm font-medium text-gray-700 mb-2\">Product Name *</label>\r\n                        <input type=\"text\" id=\"name\" name=\"name\" required\r\n                               class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent\"\r\n                               placeholder=\"e.g., Premium Organic Cacao Beans\">\r\n                    </div>\r\n                    \r\n                    <div>\r\n                        <label for=\"category\" class=\"block text-sm font-medium text-gray-700 mb-2\">Category *</label>\r\n                        <input type=\"text\" id=\"category\" name=\"category\" required\r\n                               class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent\"\r\n                               placeholder=\"e.g., Organic, Premium, Raw\">\r\n                    </div>\r\n                    \r\n                    <div>\r\n                        <label for=\"product_type\" class=\"block text-sm font-medium text-gray-700 mb-2\">Product Type *</label>\r\n                        <select id=\"product_type\" name=\"product_type\" required\r\n                                class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent\">\r\n                            <option value=\"\">Select product type</option>\r\n                            {% for type_value, type_label in product_types %}\r\n                            <option value=\"{{ type_value }}\">{{ type_label }}</option>\r\n                            {% endfor %}\r\n                        </select>\r\n                    </div>\r\n                    \r\n                    <div class=\"md:col-span-2\">\r\n                        <label for=\"description\" class=\"block text-sm font-medium text-gray-700 mb-2\">Description *</label>\r\n                        <textarea id=\"description\" name=\"description\" rows=\"4\" required\r\n                                  class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent\"\r\n                                  placeholder=\"Describe your product, its quality, origin, and benefits...\"></textarea>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- Pricing & Inventory -->\r\n            <div class=\"bg-white rounded-xl shadow-sm p-6\">\r\n                <h3 class=\"text-lg font-semibold text-gray-900 mb-6\">Pricing & Inventory</h3>\r\n                \r\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\r\n                    <div>\r\n                        <label for=\"price\" class=\"block text-sm font-medium text-gray-700 mb-2\">Price (₱) *</label>\r\n                        <input type=\"number\" id=\"price\" name=\"price\" step=\"0.01\" min=\"0\" required\r\n                               class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent\"\r\n                               placeholder=\"0.00\">\r\n                    </div>\r\n                    \r\n                    <div>\r\n                        <label for=\"stock_quantity\" class=\"block text-sm font-medium text-gray-700 mb-2\">Stock Quantity *</label>\r\n                        <input type=\"number\" id=\"stock_quantity\" name=\"stock_quantity\" min=\"0\" required\r\n                               class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent\"\r\n                               placeholder=\"0\">\r\n                    </div>\r\n                    \r\n                    <div>\r\n                        <label for=\"unit\" class=\"block text-sm font-medium text-gray-700 mb-2\">Unit *</label>\r\n                        <select id=\"unit\" name=\"unit\" required\r\n                                class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent\">\r\n                            <option value=\"kg\">Kilogram (kg)</option>\r\n                            <option value=\"g\">Gram (g)</option>\r\n                            <option value=\"lb\">Pound (lb)</option>\r\n                            <option value=\"pieces\">Pieces</option>\r\n                            <option value=\"bags\">Bags</option>\r\n                            <option value=\"boxes\">Boxes</option>\r\n                        </select>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- Product Details -->\r\n            <div class=\"bg-white rounded-xl shadow-sm p-6\">\r\n                <h3 class=\"text-lg font-semibold text-gray-900 mb-6\">Product Details</h3>\r\n                \r\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\r\n                    <div>\r\n                        <label for=\"origin\" class=\"block text-sm font-medium text-gray-700 mb-2\">Origin/Farm Location</label>\r\n                        <input type=\"text\" id=\"origin\" name=\"origin\"\r\n                               class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent\"\r\n                               placeholder=\"e.g., Ecuador, Ghana, Madagascar\">\r\n                    </div>\r\n                    \r\n                    <div>\r\n                        <label for=\"harvest_date\" class=\"block text-sm font-medium text-gray-700 mb-2\">Harvest Date</label>\r\n                        <input type=\"date\" id=\"harvest_date\" name=\"harvest_date\"\r\n                               class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent\">\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- Images -->\r\n            <div class=\"bg-white rounded-xl shadow-sm p-6\">\r\n                <h3 class=\"text-lg font-semibold text-gray-900 mb-6\">Product Images</h3>\r\n                \r\n                <div class=\"mb-4\">\r\n                    <label class=\"block text-sm font-medium text-gray-700 mb-2\">Upload Product Images</label>\r\n                    <div class=\"mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-md\">\r\n                        <div class=\"space-y-1 text-center\">\r\n                            <svg class=\"mx-auto h-12 w-12 text-gray-400\" stroke=\"currentColor\" fill=\"none\" viewBox=\"0 0 48 48\">\r\n                                <path d=\"M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" />\r\n                            </svg>\r\n                            <div class=\"flex text-sm text-gray-600\">\r\n                                <label for=\"images\" class=\"relative cursor-pointer bg-white rounded-md font-medium text-amber-600 hover:text-amber-500 focus-within:outline-none focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-amber-500\">\r\n                                    <span>Upload files</span>\r\n                                    <input id=\"images\" name=\"images\" type=\"file\" accept=\"image/*\" multiple class=\"sr-only\" onchange=\"previewImages(this)\">\r\n                                </label>\r\n                                <p class=\"pl-1\">or drag and drop</p>\r\n                            </div>\r\n                            <p class=\"text-xs text-gray-500\">PNG, JPG, GIF up to 10MB each</p>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                \r\n                <!-- Image Preview -->\r\n                <div id=\"imagePreview\" class=\"grid grid-cols-2 md:grid-cols-4 gap-4 mt-4 hidden\">\r\n                    <!-- Preview images will be inserted here -->\r\n                </div>\r\n                \r\n                <p class=\"text-sm text-gray-500 mt-2\">\r\n                    <strong>Storage Location:</strong> Images will be saved to <code>media/products/</code> folder. \r\n                    The first image will be used as the main product image.\r\n                </p>\r\n            </div>\r\n\r\n            <!-- Settings -->\r\n            <div class=\"bg-white rounded-xl shadow-sm p-6\">\r\n                <h3 class=\"text-lg font-semibold text-gray-900 mb-6\">Settings</h3>\r\n                \r\n                <div class=\"space-y-4\">\r\n                    <div class=\"flex items-center\">\r\n                        <input type=\"checkbox\" id=\"is_active\" name=\"is_active\" checked\r\n                               class=\"h-4 w-4 text-amber-600 focus:ring-amber-500 border-gray-300 rounded\">\r\n                        <label for=\"is_active\" class=\"ml-2 block text-sm text-gray-900\">\r\n                            Active (Product will be visible in marketplace)\r\n                        </label>\r\n                    </div>\r\n                    \r\n                    <div class=\"flex items-center\">\r\n                        <input type=\"checkbox\" id=\"featured\" name=\"featured\"\r\n                               class=\"h-4 w-4 text-amber-600 focus:ring-amber-500 border-gray-300 rounded\">\r\n                        <label for=\"featured\" class=\"ml-2 block text-sm text-gray-900\">\r\n                            Featured Product (Will be highlighted in marketplace)\r\n                        </label>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- Submit Buttons -->\r\n            <div class=\"flex justify-end space-x-4\">\r\n                <a href=\"{% url 'admin_products' %}\" \r\n                   class=\"px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors\">\r\n                    Cancel\r\n                </a>\r\n                <button type=\"submit\" \r\n                        class=\"px-6 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 transition-colors\">\r\n                    Create Product\r\n                </button>\r\n            </div>\r\n        </form>\r\n    </div>\r\n</div>\r\n\r\n<script>\r\nfunction previewImages(input) {\r\n    const previewContainer = document.getElementById('imagePreview');\r\n    previewContainer.innerHTML = '';\r\n    \r\n    if (input.files && input.files.length > 0) {\r\n        previewContainer.classList.remove('hidden');\r\n        \r\n        Array.from(input.files).forEach((file, index) => {\r\n            if (file.type.startsWith('image/')) {\r\n                const reader = new FileReader();\r\n                reader.onload = function(e) {\r\n                    const imageDiv = document.createElement('div');\r\n                    imageDiv.className = 'relative group';\r\n                    imageDiv.innerHTML = `\r\n                        <img src=\"${e.target.result}\" alt=\"Preview ${index + 1}\" \r\n                             class=\"w-full h-32 object-cover rounded-lg border border-gray-200\">\r\n                        <div class=\"absolute inset-0 bg-black bg-opacity-50 opacity-0 group-hover:opacity-100 transition-opacity rounded-lg flex items-center justify-center\">\r\n                            <span class=\"text-white text-sm\">Image ${index + 1}</span>\r\n                        </div>\r\n                        ${index === 0 ? '<div class=\"absolute top-2 left-2 bg-amber-500 text-white text-xs px-2 py-1 rounded\">Main</div>' : ''}\r\n                    `;\r\n                    previewContainer.appendChild(imageDiv);\r\n                };\r\n                reader.readAsDataURL(file);\r\n            }\r\n        });\r\n    } else {\r\n        previewContainer.classList.add('hidden');\r\n    }\r\n}\r\n\r\n// Drag and drop functionality\r\nconst dropZone = document.querySelector('.border-dashed');\r\nconst fileInput = document.getElementById('images');\r\n\r\ndropZone.addEventListener('dragover', (e) => {\r\n    e.preventDefault();\r\n    dropZone.classList.add('border-amber-500', 'bg-amber-50');\r\n});\r\n\r\ndropZone.addEventListener('dragleave', (e) => {\r\n    e.preventDefault();\r\n    dropZone.classList.remove('border-amber-500', 'bg-amber-50');\r\n});\r\n\r\ndropZone.addEventListener('drop', (e) => {\r\n    e.preventDefault();\r\n    dropZone.classList.remove('border-amber-500', 'bg-amber-50');\r\n    \r\n    const files = e.dataTransfer.files;\r\n    fileInput.files = files;\r\n    previewImages(fileInput);\r\n});\r\n</script>\r\n{% endblock %}\r\n"
        }
    ]
}